    "text": "[package]\nname = \"htmlescape\"\nversion = \"0.3.1\"\nauthors = [ \"Viktor Dahl <pazaconyoman@gmail.com>\" ]\nlicense = \"Apache-2.0 / MIT / MPL-2.0\"\nrepository = \"https://github.com/veddan/rust-htmlescape\"\ndescription = \"A library for HTML entity encoding and decoding\"\n\n[lib]\nname = \"htmlescape\"\npath = \"src/lib.rs\"\n\n[dev-dependencies]\nnum = \"0.1.26\"\nrand = \"0.3.14\"\n"
